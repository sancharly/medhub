# MedHub environment configuration
# Copy this file to .env and fill in real values before starting services.
# NEVER commit the actual .env file to version control.
#
# IMPORTANT: this file holds NO value for any secret setting, and docker-compose.yml has NO
# default for one. Compose stops, naming the setting, when a secret is unset or empty; the backend
# and the worker also refuse a placeholder value. Generate each secret with the command above it;
# the full list is the "Secret settings" table in infra/DEPLOY.md.

# ── Application ─────────────────────────────────────────────────────────────
# One of: local | staging | production
ENVIRONMENT=local

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Password of the database owner user "medhub", REQUIRED. Hex has no character that needs URL
# encoding:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# Owner connection, REQUIRED, used only by the db-migrate service (it runs the migrations and
# creates the runtime role); no other service receives it. Format:
#   postgresql://medhub:<POSTGRES_PASSWORD>@postgres:5432/medhub
# The password in it is the POSTGRES_PASSWORD above (percent-encode it if it is not hex).
DATABASE_OWNER_URL=
# Runtime connection, REQUIRED, used by backend, celery-worker and celery-beat. It names the
# unprivileged role "medhub_app", which db-migrate creates with this password and which cannot
# update, delete or truncate audit_log. Its password must differ from POSTGRES_PASSWORD: generate
# it with a command of its own,
#   openssl rand -hex 24
# and write: postgresql://medhub_app:<that password>@postgres:5432/medhub
DATABASE_URL=

# ── Redis ────────────────────────────────────────────────────────────────────
# Used for sessions and as the Celery broker.
REDIS_URL=redis://redis:6379/0

# ── Object Store (SeaweedFS / S3-compatible) ─────────────────────────────────────
# Endpoint URL for the S3-compatible object store.
OBJECT_STORE_ENDPOINT=http://object-store:8333
# Both keys are REQUIRED, with no default. The object-store-preflight service refuses to
# start the store when either key is unset or empty, is a well-known
# default value (list: backend/app/core/object_store_credentials.py; any case), or when the
# secret key is shorter than 16 characters. Generate them:
#   OBJECT_STORE_ACCESS_KEY: openssl rand -hex 12
#   OBJECT_STORE_SECRET_KEY: openssl rand -base64 32
# Access key ID (analogous to AWS_ACCESS_KEY_ID).
OBJECT_STORE_ACCESS_KEY=
# Secret access key — treat this as a password.
OBJECT_STORE_SECRET_KEY=
# Bucket name for attachments and DICOM files.
OBJECT_STORE_BUCKET=medhub

# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
# Port 587 = STARTTLS (recommended), 465 = SMTPS, 25 = plain (avoid)
SMTP_PORT=587
# Account name at your mail relay. Leave empty for a relay that needs no authentication; then
# SMTP_PASSWORD may stay empty. When set, SMTP_PASSWORD is required.
SMTP_USER=
# Password of that account, issued by your mail relay (not generated here). Required when
# SMTP_USER is set.
SMTP_PASSWORD=

# ── At-Rest Encryption ───────────────────────────────────────────────────────
# AES-256 key used to encrypt PHI at rest, REQUIRED: base64 of exactly 32 random bytes. Generate it
# with a command of its own, so it differs from OBJECT_STORE_SECRET_KEY:
#   openssl rand -base64 32
# Set it before the first start; it is also the object store's SSE key, so changing it later
# makes stored objects unreadable. Rotate via key management.
AT_REST_ENCRYPTION_KEY=
# Identifier of the key above, REQUIRED. Written in front of every field ciphertext
# ("mh1:<id>:...") so a value can be decrypted by the key that wrote it. 1 to 32 characters of
# a-z, 0-9 and "-"; choose a short name such as k1 or 2026-11. Set it with the key and do not
# reuse an identifier for a different key.
AT_REST_ENCRYPTION_KEY_ID=
# Earlier keys, OPTIONAL, used only to decrypt values written under them: comma-separated
# id:key entries, each key base64 of 32 random bytes (openssl rand -base64 32). Leave empty
# unless you are rotating the key (infra/DEPLOY.md). The ids must differ from the current id and
# from each other.
AT_REST_ENCRYPTION_RETIRED_KEYS=

# ── Session Timeouts ─────────────────────────────────────────────────────────
# Inactivity timeout for clinical roles (DOCTOR, PATIENT) in seconds.
SESSION_INACTIVITY_CLINICAL_SECONDS=900
# Inactivity timeout for admin roles (ADMIN, SYSADMIN) in seconds.
SESSION_INACTIVITY_ADMIN_SECONDS=1800
# Absolute maximum session lifetime in seconds (8 hours).
SESSION_ABSOLUTE_LIFETIME_SECONDS=28800
# Maximum concurrent sessions per user before oldest is evicted.
SESSION_MAX_CONCURRENT=3

# ── Cookie / CSRF ─────────────────────────────────────────────────────────────
# Set to true in production (requires HTTPS). Set to false in local dev.
SESSION_COOKIE_SECURE=true

# ── SMTP extras ───────────────────────────────────────────────────────────────
# Use STARTTLS (port 587).
SMTP_USE_TLS=true
# Use implicit TLS (port 465); takes precedence over SMTP_USE_TLS if both are true.
SMTP_USE_SSL=false
# From address for outbound emails.
MAIL_FROM=noreply@example.com
# Public base URL for activation links etc.
PUBLIC_BASE_URL=https://medhub.example

# ── Retention ─────────────────────────────────────────────────────────────────
# Cron expression for the anonymized-dataset retention sweep (5-field cron).
RETENTION_SWEEP_CRON=0 2 * * *

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins: empty (no CORS), a comma-separated list
# (https://app.example.org,https://admin.example.org) or a JSON list (["https://app.example.org"]).
CORS_ORIGINS=

# ── Trusted proxy ────────────────────────────────────────────────────────────
# Reverse-proxy addresses (comma-separated IPs or CIDR blocks) whose X-Forwarded-For is trusted
# (SR-042). Leave empty: infra/docker-compose.yml sets the backend's value to the reverse proxy's
# fixed address and a value here does not override it.
TRUSTED_PROXIES=
